<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B091A"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#171530"
        app:title="iCafe EDGE - Booking PC"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#171530"
                app:cardCornerRadius="14dp"
                app:strokeColor="#28244D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Form Booking PC"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Nama Pemesan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Nama Pemesan"
                        android:textColor="#8F8FA8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etNamaPemesan"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="#0B091A"
                        android:paddingHorizontal="12dp"
                        android:text="Eenzy"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <!-- Target PC -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="PC Target (Contoh: PC-VVIP-01)"
                        android:textColor="#8F8FA8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etPcTarget"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="#0B091A"
                        android:hint="Ketik nama PC..."
                        android:paddingHorizontal="12dp"
                        android:textColor="#00F2FE"
                        android:textColorHint="#8F8FA8"
                        android:textSize="14sp" />

                    <!-- Durasi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Durasi (Jam)"
                        android:textColor="#8F8FA8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etDurasi"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="#0B091A"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <!-- Total Harga -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Harga:"
                            android:textColor="#8F8FA8"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTotalHarga"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 15.000"
                            android:textColor="#10B981"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tombol Submit (Ringkas / Compact) -->
                    <Button
                        android:id="@+id/btnSubmitBooking"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#4F46E5"
                        android:paddingHorizontal="28dp"
                        android:text="Submit Booking"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>