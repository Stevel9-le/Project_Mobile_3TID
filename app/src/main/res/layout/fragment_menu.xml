<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B091A"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#171530"
        app:title="iCafe EDGE - Pemesanan Makanan"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#171530"
                app:cardCornerRadius="14dp"
                app:strokeColor="#28244D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Form Pemesanan Makanan &amp; Minuman"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Ketik Makanan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Nama Makanan"
                        android:textColor="#8F8FA8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etNamaMakanan"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="#0B091A"
                        android:hint="Contoh: Nasi Goreng Intel Core"
                        android:paddingHorizontal="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8F8FA8"
                        android:textSize="14sp" />

                    <!-- Ketik Minuman -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nama Minuman"
                        android:textColor="#8F8FA8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etNamaMinuman"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="#0B091A"
                        android:hint="Contoh: Es Kopi Susu Anti-Lag"
                        android:paddingHorizontal="12dp"
                        android:textColor="#00F2FE"
                        android:textColorHint="#8F8FA8"
                        android:textSize="14sp" />

                    <!-- Catatan Khusus -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Catatan Khusus (opsional)"
                        android:textColor="#8F8FA8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etCatatan"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="#0B091A"
                        android:hint="Contoh: Tanpa es, telur setengah matang..."
                        android:paddingHorizontal="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8F8FA8"
                        android:textSize="14sp" />

                    <!-- Total Pembayaran -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL PEMBAYARAN:"
                            android:textColor="#8F8FA8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotalPembayaran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 30.000"
                            android:textColor="#10B981"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tombol Kirim / Bayar (Ringkas & Tidak Panjang) -->
                    <Button
                        android:id="@+id/btnKirimPesanan"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#4F46E5"
                        android:paddingHorizontal="28dp"
                        android:text="Kirim Pesanan"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>